# Copy this file to .env and fill in your values. Never commit .env.
# Your project's Region (AWS Settings > Project > Additional Info). Israel = eu-north-1
AWS_REGION=eu-north-1
AWS_PROFILE=cloudtrail-detective

# S3 bucket names are global: add something unique, e.g. your initials and a number
S3_BUCKET=cloudtrail-detective-xx-123

ATHENA_DATABASE=cloudtrail_detective
ATHENA_TABLE=cloudtrail_logs
